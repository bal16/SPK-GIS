# =============================================================================
# Salin menjadi .env lalu sesuaikan nilainya.
#   cp .env.example .env
# File .env dipakai otomatis oleh Docker Compose dan podman-compose.
# =============================================================================

# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=spk_gis

# --- Autentikasi ------------------------------------------------------------
# Gunakan string acak yang panjang, misalnya hasil `openssl rand -base64 48`.
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production

# --- Backend Config ---------------------------------------------------------
# Origin frontend yang diizinkan mengakses API (CORS). Pisahkan koma jika lebih dari satu.
CORS_ORIGIN=http://localhost:3000,https://spk-gis.vercel.app

# --- Frontend Config --------------------------------------------------------
# URL backend yang dipanggil BROWSER (Client-side).
# - Dev lokal   : http://localhost:3001
# - Produksi    : https://spk-gis-be.vercel.app
NEXT_PUBLIC_NEST_API_URL=http://localhost:3001

# URL backend yang dipanggil SERVER NEXT.JS (Server Components / SSR / Server Actions).
# - Dev lokal   : http://localhost:3001
# - Docker      : http://backend:3001
# - Produksi    : https://spk-gis-be.vercel.app
NEST_API_URL=http://localhost:3001

# URL publik frontend (Opsional - untuk metadata base OpenGraph & Canonical).
# Di Vercel, variabel ini otomatis terdeteksi jika tidak diisi.
# NEXT_PUBLIC_APP_URL=https://spk-gis.vercel.app
