# =============================================================================
# Salin menjadi .env lalu sesuaikan nilainya.
#   cp .env.example .env
# File .env dipakai otomatis oleh Docker Compose dan podman-compose.
# =============================================================================

# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=spk_gis

# --- Autentikasi ------------------------------------------------------------
# Gunakan string acak yang panjang, misalnya hasil `openssl rand -base64 48`.
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production

# --- Frontend ---------------------------------------------------------------
# URL backend yang dipanggil BROWSER (bukan dari dalam container).
# - Dev lokal   : http://localhost:3001
# - Produksi    : https://api.domain-anda.com
# Nilai ini di-bake saat build frontend, jadi rebuild setelah mengubahnya.
NEXT_PUBLIC_NEST_API_URL=http://localhost:3001
